{
  "name": "@vanherk/portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:nuxt && npm run test:e2e",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
