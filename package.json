    "@nuxt/hints": "^1.1.5",
    "@nuxt/icon": "^2.6.2",
    "@nuxt/image": "^2.2.1",
    "@nuxt/test-utils": "^4.4.0",
    "@tailwindcss/vite": "^4.3.5",
    "better-sqlite3": "^13.2.0",
    "eslint": "^10.15.0",
    "nuxt": "^4.6.4",
    "nuxt-headlessui": "^1.2.2",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/test-utils": "^2.5.1",
